# Normalize text to LF, but let Git detect binary content. Forcing `text` on
# every path rewrote CRLF byte pairs inside binaries (model.moc3, webp, zip).
*       text=auto eol=lf

# Binary formats are listed explicitly so detection never depends on content.
*.exe     binary
*.dll     binary
*.so      binary
*.so.*    binary
*.a       binary
*.jar     binary
*.class   binary
*.dex     binary
*.apk     binary
*.aab     binary
*.keystore binary
*.jks     binary
*.p12     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.avif    binary
*.bmp     binary
*.ico     binary
*.icns    binary
*.eot     binary
*.otf     binary
*.ttf     binary
*.woff    binary
*.woff2   binary
*.mp3     binary
*.wav     binary
*.ogg     binary
*.m4a     binary
*.mp4     binary
