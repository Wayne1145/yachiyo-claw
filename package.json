  "private": true,
  "description": "An Android-first AI chat and local device agent",
  "scripts": {
    "generate:routes": "node scripts/generate-route-tree.mjs",
    "generate:model-snapshot": "pnpm exec tsx scripts/generate-model-snapshot.ts",
    "plugin:create": "node scripts/create-plugin.mjs",
    "plugin:build-example": "node scripts/build-example-plugin.mjs",
    "plugin:build-marketplace": "node scripts/build-plugin-marketplace.mjs",
    "test:plugin-isolation": "tsx scripts/test-plugin-isolation.mts",
    "verify:android-update-release": "node scripts/verify-android-update-release.mjs",
    "dev": "cross-env CHATBOX_BUILD_TARGET=mobile_app CHATBOX_BUILD_PLATFORM=android vite",
    "dev:web": "cross-env CHATBOX_BUILD_PLATFORM=web vite",
    "build:web": "cross-env CHATBOX_BUILD_PLATFORM=web vite build",
    "serve:web": "npx serve ./dist/renderer",
    "test": "vitest run",
    "test:android-foundation": "vitest run src/shared/agent/contracts.test.ts src/renderer/native/stream-http.test.ts src/renderer/mobile/agent-broker.test.ts src/renderer/mobile/scheduled-agent-tasks.test.ts src/renderer/platform/mobile_deep_link.test.ts src/renderer/platform/storages.mobile-secure.test.ts src/renderer/setup/mobile_telemetry_init.test.ts src/renderer/setup/telemetry_policy.test.ts src/renderer/stores/authInfoStorage.mobile-secure.test.ts src/renderer/stores/authInfoStore.mobile-secure.test.ts src/renderer/stores/settingsStore.persist.test.ts src/renderer/utils/mobile-request.test.ts src/renderer/utils/request.mobile.test.ts src/renderer/hooks/useVersion.test.ts src/renderer/mobile/android-app-shell.test.ts src/renderer/mobile/yachiyo-api.test.ts src/renderer/platform/native/yachiyo_appearance.test.ts src/renderer/components/InputBox/mobile-primary-action.test.ts src/renderer/components/common/AdaptiveModal.test.tsx src/renderer/components/yachiyo/AndroidBottomNavigation.test.tsx src/renderer/components/yachiyo/AndroidMainTabPager.test.tsx src/renderer/components/yachiyo/AndroidPagerHeaderTransition.test.tsx src/renderer/components/yachiyo/AndroidSharedChrome.test.tsx src/renderer/components/yachiyo/AndroidTabPagePreview.test.tsx src/renderer/components/yachiyo/android-main-tab-pager-physics.test.ts src/renderer/components/yachiyo/android-pager-gesture-lock.test.tsx src/renderer/components/yachiyo/android-retained-state.test.tsx src/renderer/components/yachiyo/AdaptiveActionCluster.test.tsx src/renderer/components/yachiyo/AdaptiveAndroidActionGroups.ui.test.ts src/renderer/components/yachiyo/useAdaptiveControlDensity.test.tsx src/renderer/components/yachiyo/android-conversation-swipe-physics.test.ts src/renderer/components/yachiyo/AndroidInteractive.lifecycle.test.tsx src/renderer/components/yachiyo/Live2DStage.lifecycle.test.tsx src/renderer/components/yachiyo/AndroidConversationChrome.ui.test.ts src/renderer/components/yachiyo/flow-glass-style.test.ts src/renderer/components/yachiyo/YachiyoApiOnboarding.test.tsx src/renderer/plugins/PluginPageHost.test.tsx",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration --testTimeout=300000",
    "test:file-conversation": "vitest run test/integration/file-conversation --testTimeout=120000",
    "test:model-provider": "vitest run test/integration/model-provider --testTimeout=120000",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "check": "pnpm run generate:routes && npx tsc --noEmit",
    "check:android-native-logs": "node scripts/check-android-native-logs.mjs",
    "format": "biome format --write",
    "check:biome": "biome check",
    "check:ci": "biome ci",
    "mobile:sync": "pnpm run mobile:sync:android",
    "mobile:sync:android": "cross-env CHATBOX_BUILD_TARGET=mobile_app CHATBOX_BUILD_PLATFORM=android vite build && npx cap sync android",
    "mobile:android": "pnpm run mobile:sync:android && npx cap open android",
    "mobile:assets:yachiyo": "node scripts/generate-android-brand-assets.mjs",
    "mobile:assets:live2d": "node scripts/prepare-live2d-assets.mjs",
    "mobile:assets": "npx capacitor-assets generate --ios --android",
    "prepare": "node -e \"try { require('husky') } catch(e) { process.exit(0) }\" && husky || true",
    "check:error-i18n-keys": "node script/sync-error-i18n-keys.mjs --check",
    "sync:error-i18n-keys": "node script/sync-error-i18n-keys.mjs",
    "translate": "pnpm run sync:error-i18n-keys && i18next && node script/translate.mjs"
  },
